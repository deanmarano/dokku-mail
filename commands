#!/usr/bin/env bash
PLUGIN_BASE_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$PLUGIN_BASE_PATH/config"
[[ " mail:help mail " == *" $1 "* ]] || [[ "$1" == "mail:"* ]] || exit "$DOKKU_NOT_IMPLEMENTED_EXIT"

set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

show_help() {
  echo -e "\033[1musage\033[m: dokku mail[:COMMAND]"
  echo ""
  echo -e "\033[1mManage mail relay services for sending email from apps.\033[m"
  echo ""
  echo -e "\033[0;34mExample:\033[m"
  echo ""
  echo "    $ dokku mail:list"
  echo ""
  echo "      Mail services"
  echo "      default (resend)"
  echo ""
  echo -e "dokku \033[1mmail\033[m commands:"
  echo ""
  echo -e "    mail:create <service>                             \033[2;37mcreate a mail relay service\033[m"
  echo -e "    mail:destroy <service> [-f|--force]               \033[2;37mdelete the mail service/container\033[m"
  echo -e "    mail:doctor <service>                             \033[2;37mrun diagnostics and check for issues\033[m"
  echo -e "    mail:info <service>                               \033[2;37mprint the service information\033[m"
  echo -e "    mail:link <service> <app>                         \033[2;37mlink the mail service to the app\033[m"
  echo -e "    mail:list                                         \033[2;37mlist all mail services\033[m"
  echo -e "    mail:logs <service> [-t|--tail]                   \033[2;37mprint the most recent log(s) for this service\033[m"
  echo -e "    mail:test <service> <to-address>                  \033[2;37msend a test email\033[m"
  echo -e "    mail:unlink <service> <app>                       \033[2;37munlink the mail service from the app\033[m"
  echo ""
  echo -e "    mail:provider:apply <service>                     \033[2;37mapply provider configuration changes\033[m"
  echo -e "    mail:provider:config <service> KEY=value          \033[2;37mset provider configuration\033[m"
  echo -e "    mail:provider:info <service>                      \033[2;37mshow provider configuration\033[m"
  echo -e "    mail:provider:reset <service>                     \033[2;37mreset provider for re-configuration\033[m"
  echo -e "    mail:provider:set <service> <provider>            \033[2;37mset the provider (mock, aws, resend)\033[m"
  echo -e "    mail:provider:verify <service>                    \033[2;37mverify provider credentials\033[m"
  echo ""
  echo -e "    mail:aws:add-domain <service> <domain>            \033[2;37madd additional sender domain to AWS SES\033[m"
  echo -e "    mail:aws:setup <service> <domain> [region]        \033[2;37mset up AWS SES with automatic DNS configuration\033[m"
  echo ""
  echo -e "    mail:resend:setup <service> <domain> [api-key]    \033[2;37mset up Resend with automatic DNS configuration\033[m"
}

case "$1" in
  mail|mail:help)
    show_help
    ;;
  mail:*)
    subcommand="${1#mail:}"
    shift
    if [[ -x "$PLUGIN_BASE_PATH/subcommands/$subcommand" ]]; then
      exec "$PLUGIN_BASE_PATH/subcommands/$subcommand" "$@"
    else
      echo "Unknown command: mail:$subcommand"
      echo "Run 'dokku mail:help' for usage"
      exit 1
    fi
    ;;
  *)
    exit "$DOKKU_NOT_IMPLEMENTED_EXIT"
    ;;
esac
