#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

PLUGIN_BASE_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$PLUGIN_BASE_PATH/config"

case "$1" in
  mail:help)
    echo "Usage: dokku mail[:COMMAND]"
    echo ""
    echo "Manage mail relay services"
    echo ""
    echo "Commands:"
    echo "  mail:create [name]           Create a mail relay service (default: 'default')"
    echo "  mail:destroy <name>          Destroy a mail relay service"
    echo "  mail:link <name> <app>       Link app to mail service"
    echo "  mail:unlink <name> <app>     Unlink app from mail service"
    echo "  mail:test <name> <to>        Send test email"
    echo "  mail:logs <name> [-t]        Show service logs"
    echo "  mail:list                    List all mail services"
    echo "  mail:info <name>             Show service info"
    echo "  mail:doctor <name>           Run diagnostics and check for issues"
    echo ""
    echo "Provider commands:"
    echo "  mail:provider:set <name> <provider>     Set provider (mock, aws)"
    echo "  mail:provider:config <name> KEY=val     Configure provider settings"
    echo "  mail:provider:apply <name>              Apply provider changes"
    echo "  mail:provider:info <name>               Show provider config"
    echo "  mail:provider:verify <name>             Verify provider credentials"
    echo "  mail:provider:reset <name>              Reset provider for re-setup"
    echo ""
    echo "AWS SES:"
    echo "  mail:aws:setup <name> <domain> [region] Automatically set up AWS SES"
    echo "  mail:aws:add-domain <name> <domain>     Add additional sender domain"
    echo ""
    echo "Resend:"
    echo "  mail:resend:setup <name> <domain> [key] Set up Resend as provider"
    ;;
  mail:*)
    subcommand="${1#mail:}"
    shift
    if [[ -x "$PLUGIN_BASE_PATH/subcommands/$subcommand" ]]; then
      exec "$PLUGIN_BASE_PATH/subcommands/$subcommand" "$@"
    else
      echo "Unknown command: mail:$subcommand"
      echo "Run 'dokku mail:help' for usage"
      exit 1
    fi
    ;;
  *)
    exit "$DOKKU_NOT_IMPLEMENTED_EXIT"
    ;;
esac
