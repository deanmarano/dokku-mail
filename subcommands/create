#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

PLUGIN_BASE_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$PLUGIN_BASE_PATH/config"
source "$PLUGIN_BASE_PATH/providers/loader.sh"

# Skip command name if passed (dokku passes "mail:create" as $1)
[[ "$1" == "mail:create" ]] && shift

SERVICE="${1:-default}"

SERVICE_ROOT="$PLUGIN_DATA_ROOT/$SERVICE"
CONTAINER_NAME="dokku.mail.$SERVICE"
NETWORK_NAME="dokku.mail.$SERVICE"

# Check if service already exists
if [[ -d "$SERVICE_ROOT" ]]; then
  echo "!     Service $SERVICE already exists"
  exit 1
fi

echo "-----> Creating mail service $SERVICE"

# Create service directory
mkdir -p "$SERVICE_ROOT"
mkdir -p "$SERVICE_ROOT/provider-config"

# Set default provider to mock
echo "mock" > "$SERVICE_ROOT/PROVIDER"

# Load mock provider
load_provider "$SERVICE"

# Create Docker network for this service
echo "-----> Creating network $NETWORK_NAME"
docker network create "$NETWORK_NAME" 2>/dev/null || true

# Pull image
echo "-----> Pulling $PROVIDER_IMAGE:$PROVIDER_IMAGE_VERSION"
docker pull "$PROVIDER_IMAGE:$PROVIDER_IMAGE_VERSION" || true

# Create container using provider (pass network name)
echo "-----> Starting container"
export MAIL_NETWORK="$NETWORK_NAME"
provider_create_container "$SERVICE"

# Store service metadata
echo "$CONTAINER_NAME" > "$SERVICE_ROOT/CONTAINER_NAME"
echo "$PROVIDER_IMAGE:$PROVIDER_IMAGE_VERSION" > "$SERVICE_ROOT/IMAGE"
touch "$SERVICE_ROOT/LINKS"

echo "-----> Mail service $SERVICE created"
echo "       Container: $CONTAINER_NAME"
echo "       Provider: $PROVIDER_NAME ($PROVIDER_DISPLAY_NAME)"

if [[ -n "$PROVIDER_WEB_PORT" ]]; then
  echo "       Web UI: http://localhost:$PROVIDER_WEB_PORT"
fi

echo ""
echo "       Next: dokku mail:link $SERVICE <app>"
echo ""
echo "       To switch to AWS SES for real delivery:"
echo "         dokku mail:provider:set $SERVICE aws"
