#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

PLUGIN_BASE_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$PLUGIN_BASE_PATH/config"
source "$PLUGIN_BASE_PATH/providers/loader.sh"

# Skip command name if passed
[[ "$1" == "mail:test" ]] && shift

SERVICE="$1"
TO="$2"

if [[ -z "$SERVICE" ]] || [[ -z "$TO" ]]; then
  echo "Usage: dokku mail:test <name> <to-email>"
  echo ""
  echo "Send a test email through the mail service"
  exit 1
fi

SERVICE_ROOT="$PLUGIN_DATA_ROOT/$SERVICE"
CONTAINER_NAME="dokku.mail.$SERVICE"

# Check if service exists
if [[ ! -d "$SERVICE_ROOT" ]]; then
  echo "!     Service $SERVICE does not exist"
  exit 1
fi

# Check if container is running
if ! docker ps -q -f "name=$CONTAINER_NAME" | grep -q .; then
  echo "!     Service $SERVICE is not running"
  echo "      Run: dokku mail:start $SERVICE"
  exit 1
fi

# Load provider to get correct SMTP port
load_provider "$SERVICE"
SMTP_PORT=$(provider_get_smtp_port)

# Get container IP
CONTAINER_IP=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "$CONTAINER_NAME")

TIMESTAMP=$(date -u +"%Y-%m-%d %H:%M:%S UTC")
HOSTNAME=$(hostname)

# Get sender domain (for SES verified identity) or fall back to hostname
SENDER_DOMAIN=$(cat "$SERVICE_ROOT/provider-config/SENDER_DOMAIN" 2>/dev/null || echo "$HOSTNAME")
FROM_ADDR="dokku-mail@$SENDER_DOMAIN"

echo "-----> Sending test email to $TO"
echo "       From: $FROM_ADDR"

# Build the email message
EMAIL_MSG="From: $FROM_ADDR
To: $TO
Subject: [dokku-mail] Test email from $SERVICE
Date: $TIMESTAMP

This is a test email sent from dokku mail service '$SERVICE'.

Timestamp: $TIMESTAMP
Server: $HOSTNAME
Service: $SERVICE

If you received this email, mail delivery is working correctly.

--
Sent by dokku-mail plugin"

# Send via docker exec using sendmail inside the container (works for Postfix-based providers)
# For MailHog, fall back to nc with longer delays
if [[ "$PROVIDER_NAME" == "mock" ]]; then
  # MailHog accepts pipelined commands
  {
    sleep 0.2
    echo "HELO localhost"
    sleep 0.2
    echo "MAIL FROM:<$FROM_ADDR>"
    sleep 0.2
    echo "RCPT TO:<$TO>"
    sleep 0.2
    echo "DATA"
    sleep 0.2
    echo "$EMAIL_MSG"
    echo "."
    sleep 0.2
    echo "QUIT"
  } | nc -q 2 "$CONTAINER_IP" "$SMTP_PORT"
else
  # Use sendmail inside the Postfix container
  echo "$EMAIL_MSG" | docker exec -i "$CONTAINER_NAME" sendmail -f "$FROM_ADDR" "$TO"
fi

echo "-----> Test email sent to $TO"
if [[ "$PROVIDER_NAME" == "mock" ]]; then
  echo "       View in MailHog UI: http://localhost:$PROVIDER_WEB_PORT"
fi
