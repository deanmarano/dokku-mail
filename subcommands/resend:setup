#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

PLUGIN_BASE_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$PLUGIN_BASE_PATH/config"

# Skip command name if passed
[[ "$1" == "mail:resend:setup" ]] && shift

SERVICE="${1:-default}"
DOMAIN="$2"
API_KEY="$3"

if [[ -z "$DOMAIN" ]]; then
  echo "Usage: dokku mail:resend:setup <service> <domain> [api-key]"
  echo ""
  echo "Set up Resend as the mail provider"
  echo ""
  echo "This command will:"
  echo "  - Add your domain to Resend"
  echo "  - Configure DNS records in Route53"
  echo "  - Set up the mail service"
  echo ""
  echo "Requirements:"
  echo "  - Resend API key (get from https://resend.com/api-keys)"
  echo "  - Domain hosted in Route53"
  echo "  - jq installed"
  echo ""
  echo "Example:"
  echo "  dokku mail:resend:setup default example.com re_123abc..."
  exit 1
fi

SERVICE_ROOT="$PLUGIN_DATA_ROOT/$SERVICE"

# Check if service exists
if [[ ! -d "$SERVICE_ROOT" ]]; then
  echo "!     Service $SERVICE does not exist"
  echo "      Run: dokku mail:create $SERVICE"
  exit 1
fi

# Check for jq
if ! command -v jq &>/dev/null; then
  echo "!     jq not found. Please install it first."
  echo "      apt-get install jq"
  exit 1
fi

# Check if already configured
CURRENT_PROVIDER=$(cat "$SERVICE_ROOT/PROVIDER" 2>/dev/null || echo "")
if [[ "$CURRENT_PROVIDER" == "resend" ]]; then
  EXISTING_DOMAIN=$(cat "$SERVICE_ROOT/provider-config/SENDER_DOMAIN" 2>/dev/null || echo "")
  if [[ -n "$EXISTING_DOMAIN" ]]; then
    echo "-----> Service $SERVICE is already configured for Resend"
    echo "       Sender Domain: $EXISTING_DOMAIN"
    echo ""
    echo "       To reconfigure, first run: dokku mail:provider:reset $SERVICE"
    exit 0
  fi
fi

# Prompt for API key if not provided
if [[ -z "$API_KEY" ]]; then
  echo "Enter your Resend API key (starts with re_):"
  read -r API_KEY
fi

if [[ -z "$API_KEY" ]]; then
  echo "!     API key is required"
  exit 1
fi

if [[ ! "$API_KEY" =~ ^re_ ]]; then
  echo "!     Invalid API key format (should start with re_)"
  exit 1
fi

echo "-----> Setting up Resend for $DOMAIN"

# Step 1: Check/create domain in Resend
echo "-----> Checking domain in Resend..."

# Check if domain already exists
DOMAIN_RESPONSE=$(curl -s "https://api.resend.com/domains" \
  -H "Authorization: Bearer $API_KEY" \
  -H "Content-Type: application/json")

DOMAIN_ID=$(echo "$DOMAIN_RESPONSE" | jq -r ".data[] | select(.name == \"$DOMAIN\") | .id" 2>/dev/null || echo "")

if [[ -z "$DOMAIN_ID" ]]; then
  echo "       Creating domain in Resend..."
  CREATE_RESPONSE=$(curl -s -X POST "https://api.resend.com/domains" \
    -H "Authorization: Bearer $API_KEY" \
    -H "Content-Type: application/json" \
    -d "{\"name\": \"$DOMAIN\"}")

  DOMAIN_ID=$(echo "$CREATE_RESPONSE" | jq -r '.id // empty' 2>/dev/null || echo "")

  if [[ -z "$DOMAIN_ID" ]]; then
    echo "!     Failed to create domain in Resend"
    echo "      Response: $CREATE_RESPONSE"
    exit 1
  fi
  echo "       Domain created: $DOMAIN_ID"
  sleep 2
else
  echo "       Domain already exists: $DOMAIN_ID"
fi

# Step 2: Get DNS records
echo "-----> Getting DNS records..."
DOMAIN_INFO=$(curl -s "https://api.resend.com/domains/$DOMAIN_ID" \
  -H "Authorization: Bearer $API_KEY")

if [[ -z "$DOMAIN_INFO" ]]; then
  echo "!     Empty response from Resend API"
  exit 1
fi

DOMAIN_STATUS=$(echo "$DOMAIN_INFO" | jq -r '.status // "unknown"')
echo "       Status: $DOMAIN_STATUS"

RECORD_COUNT=$(echo "$DOMAIN_INFO" | jq '.records | length')
if [[ "$RECORD_COUNT" -eq 0 ]]; then
  echo "!     No DNS records returned from Resend"
  exit 1
fi

# Step 3: Check for dokku-dns or Route53
USE_DOKKU_DNS=false
if command -v dokku &>/dev/null && dokku dns:version &>/dev/null 2>&1; then
  echo "-----> Using dokku-dns for DNS management"
  USE_DOKKU_DNS=true
else
  echo "-----> Finding Route53 hosted zone for $DOMAIN..."
  HOSTED_ZONE_ID=$(aws route53 list-hosted-zones --query "HostedZones[?Name=='${DOMAIN}.'].Id" --output text 2>/dev/null | sed 's|/hostedzone/||')
fi

if [[ "$USE_DOKKU_DNS" == false ]] && [[ -z "$HOSTED_ZONE_ID" ]]; then
  echo "!     No Route53 hosted zone found for $DOMAIN"
  echo ""
  echo "       Add these DNS records manually:"
  echo "$DOMAIN_INFO" | jq -r '.records[] | "         \(.type) \(.name) -> \(.value)"'
  echo ""
  echo "       Tip: Install dokku-dns to use any DNS provider"
  echo "       Then verify in Resend dashboard and re-run this command."
else
  if [[ "$USE_DOKKU_DNS" == false ]]; then
    echo "       Found zone: $HOSTED_ZONE_ID"
  fi

  # Step 4: Add DNS records
  echo "-----> Adding DNS records..."

  # Process each record using jq
  echo "$DOMAIN_INFO" | jq -c '.records[]' | while read -r record; do
    TYPE=$(echo "$record" | jq -r '.type')
    NAME=$(echo "$record" | jq -r '.name')
    VALUE=$(echo "$record" | jq -r '.value')
    TTL=$(echo "$record" | jq -r '.ttl // "Auto"')

    [[ -z "$TYPE" ]] && continue
    [[ -z "$NAME" ]] && continue

    # Append domain to subdomain
    FULL_NAME="${NAME}.${DOMAIN}"

    # Handle TTL
    if [[ "$TTL" == "Auto" ]] || [[ -z "$TTL" ]]; then
      TTL=300
    fi

    echo "       Adding: $TYPE $FULL_NAME"

    if [[ "$USE_DOKKU_DNS" == true ]]; then
      if dokku dns:records:create "$FULL_NAME" "$TYPE" "$VALUE" --ttl "$TTL" >/dev/null 2>&1; then
        echo "         ✓ Added"
      else
        echo "         ✗ Failed to add"
      fi
    else
      # Fallback to Route53 API
      # For TXT records, wrap value in quotes
      if [[ "$TYPE" == "TXT" ]]; then
        VALUE="\"$VALUE\""
      fi

      # Build change batch JSON using jq
      CHANGE_BATCH=$(jq -n \
        --arg name "$FULL_NAME" \
        --arg type "$TYPE" \
        --argjson ttl "$TTL" \
        --arg value "$VALUE" \
        '{
          Changes: [{
            Action: "UPSERT",
            ResourceRecordSet: {
              Name: $name,
              Type: $type,
              TTL: $ttl,
              ResourceRecords: [{Value: $value}]
            }
          }]
        }')

      if aws route53 change-resource-record-sets \
        --hosted-zone-id "$HOSTED_ZONE_ID" \
        --change-batch "$CHANGE_BATCH" >/dev/null 2>&1; then
        echo "         ✓ Added"
      else
        echo "         ✗ Failed to add"
      fi
    fi
  done

  echo "       DNS records added"
fi

# Step 5: Verify domain (trigger verification check)
echo "-----> Triggering domain verification..."
curl -s -X POST "https://api.resend.com/domains/$DOMAIN_ID/verify" \
  -H "Authorization: Bearer $API_KEY" >/dev/null 2>&1 || true

# Step 6: Configure the mail service
echo "-----> Configuring mail service..."
mkdir -p "$SERVICE_ROOT/provider-config"
echo "resend" > "$SERVICE_ROOT/PROVIDER"
echo "$API_KEY" > "$SERVICE_ROOT/provider-config/API_KEY"
echo "$DOMAIN" > "$SERVICE_ROOT/provider-config/SENDER_DOMAIN"

echo "-----> Applying provider configuration..."
dokku mail:provider:apply "$SERVICE"

# Check final status
sleep 2
FINAL_STATUS=$(curl -s "https://api.resend.com/domains/$DOMAIN_ID" \
  -H "Authorization: Bearer $API_KEY" | jq -r '.status // "unknown"')

echo ""
echo "-----> Resend setup complete!"
echo "       Domain: $DOMAIN"
echo "       Status: $FINAL_STATUS"
echo "       Service: $SERVICE"
echo ""

if [[ "$FINAL_STATUS" != "verified" ]]; then
  echo "       DNS verification may take a few minutes."
  echo "       Check status: curl -s https://api.resend.com/domains/$DOMAIN_ID -H 'Authorization: Bearer $API_KEY' | jq .status"
  echo ""
fi

echo "       Test with: dokku mail:test $SERVICE your@email.com"
