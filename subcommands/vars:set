#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

PLUGIN_BASE_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$PLUGIN_BASE_PATH/config"

# Skip command name if passed
[[ "$1" == "mail:vars:set" ]] && shift

APP="$1"
shift || true

if [[ -z "$APP" ]] || [[ $# -eq 0 ]]; then
  echo "Usage: dokku mail:vars:set <app> KEY=VALUE [KEY=VALUE...]"
  echo ""
  echo "Set custom environment variable mappings for an app"
  echo ""
  echo "Placeholders available in values:"
  echo "  %HOST%   - SMTP container IP address"
  echo "  %PORT%   - SMTP port"
  echo "  %DOMAIN% - Sender domain (if configured)"
  echo "  %APP%    - App name"
  echo ""
  echo "Examples:"
  echo "  dokku mail:vars:set myapp MAILER_HOST=%HOST%"
  echo "  dokku mail:vars:set myapp MAILER_DSN=smtp://%HOST%:%PORT%"
  echo "  dokku mail:vars:set myapp EMAIL_FROM=noreply@%DOMAIN%"
  echo ""
  echo "Built-in templates:"
  for t in "$PLUGIN_BASE_PATH/templates"/*; do
    [[ -f "$t" ]] && echo "  dokku mail:vars:set myapp --template=$(basename "$t")"
  done
  echo "  dokku mail:vars:set myapp --template=none  (clear)"
  exit 1
fi

# Create vars directory if needed
VARS_DIR="$PLUGIN_DATA_ROOT/app-vars"
mkdir -p "$VARS_DIR"

APP_VARS_FILE="$VARS_DIR/$APP"

# Check for template flag
if [[ "$1" == "--template="* ]]; then
  TEMPLATE="${1#--template=}"
  TEMPLATES_DIR="$PLUGIN_BASE_PATH/templates"

  # Handle special cases
  case "$TEMPLATE" in
    none|clear)
      rm -f "$APP_VARS_FILE"
      echo "-----> Cleared all custom vars for $APP (will use defaults only)"
      ;;
    *)
      # Check if template file exists
      if [[ -f "$TEMPLATES_DIR/$TEMPLATE" ]]; then
        cp "$TEMPLATES_DIR/$TEMPLATE" "$APP_VARS_FILE"
        echo "-----> Applied $TEMPLATE template for $APP"
      else
        echo "!     Unknown template: $TEMPLATE"
        echo "      Available templates:"
        for t in "$TEMPLATES_DIR"/*; do
          [[ -f "$t" ]] && echo "        $(basename "$t")"
        done
        echo "        none (clear all)"
        exit 1
      fi
      ;;
  esac

  cat "$APP_VARS_FILE" 2>/dev/null || true

  # Auto re-link if app is already linked to a service
  for service_dir in "$PLUGIN_DATA_ROOT"/*/; do
    service=$(basename "$service_dir")
    [[ "$service" == "app-vars" ]] && continue
    if grep -q "^$APP$" "$service_dir/LINKS" 2>/dev/null; then
      echo ""
      "$PLUGIN_BASE_PATH/subcommands/link" "$service" "$APP"
      exit 0
    fi
  done
  exit 0
fi

# Process KEY=VALUE arguments
for arg in "$@"; do
  if [[ "$arg" != *"="* ]]; then
    echo "!     Invalid format: $arg (expected KEY=VALUE)"
    exit 1
  fi

  KEY="${arg%%=*}"
  VALUE="${arg#*=}"

  # Strip surrounding quotes if present (handles user escaping)
  if [[ "$VALUE" =~ ^\"(.*)\"$ ]] || [[ "$VALUE" =~ ^\'(.*)\'$ ]]; then
    VALUE="${BASH_REMATCH[1]}"
  fi

  # Remove existing line with this key if present
  if [[ -f "$APP_VARS_FILE" ]]; then
    grep -v "^${KEY}=" "$APP_VARS_FILE" > "$APP_VARS_FILE.tmp" 2>/dev/null || true
    mv "$APP_VARS_FILE.tmp" "$APP_VARS_FILE"
  fi

  # Add new line
  echo "${KEY}=${VALUE}" >> "$APP_VARS_FILE"
  echo "       $KEY=$VALUE"
done

echo "-----> Updated vars for $APP"

# Auto re-link if app is already linked to a service
for service_dir in "$PLUGIN_DATA_ROOT"/*/; do
  service=$(basename "$service_dir")
  [[ "$service" == "app-vars" ]] && continue
  if grep -q "^$APP$" "$service_dir/LINKS" 2>/dev/null; then
    echo ""
    "$PLUGIN_BASE_PATH/subcommands/link" "$service" "$APP"
    exit 0
  fi
done

echo ""
echo "       Link app to apply: dokku mail:link <service> $APP"
