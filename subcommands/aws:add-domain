#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

PLUGIN_BASE_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$PLUGIN_BASE_PATH/config"

# Skip command name if passed
[[ "$1" == "mail:aws:add-domain" ]] && shift

SERVICE="${1:-default}"
DOMAIN="$2"

if [[ -z "$DOMAIN" ]]; then
  echo "Usage: dokku mail:aws:add-domain <service> <domain>"
  echo ""
  echo "Add an additional sender domain to AWS SES"
  echo ""
  echo "Example:"
  echo "  dokku mail:aws:add-domain default dean.is"
  exit 1
fi

SERVICE_ROOT="$PLUGIN_DATA_ROOT/$SERVICE"

# Check if service exists
if [[ ! -d "$SERVICE_ROOT" ]]; then
  echo "!     Service $SERVICE does not exist"
  exit 1
fi

# Get region from existing config
REGION=$(cat "$SERVICE_ROOT/provider-config/AWS_REGION" 2>/dev/null || echo "us-east-1")

# Check for AWS CLI
if ! command -v aws &>/dev/null; then
  echo "!     AWS CLI not found. Please install it first."
  exit 1
fi

echo "-----> Adding sender domain $DOMAIN to SES"

# Check if identity already exists
if aws sesv2 get-email-identity --email-identity "$DOMAIN" --region "$REGION" &>/dev/null; then
  echo "       Identity already exists, checking status..."
  DKIM_STATUS=$(aws sesv2 get-email-identity --email-identity "$DOMAIN" --region "$REGION" \
    --query 'DkimAttributes.Status' --output text)
  VERIFIED=$(aws sesv2 get-email-identity --email-identity "$DOMAIN" --region "$REGION" \
    --query 'VerifiedForSendingStatus' --output text)

  echo "       DKIM: $DKIM_STATUS"
  echo "       Verified: $VERIFIED"

  if [[ "$DKIM_STATUS" == "SUCCESS" ]] && [[ "$VERIFIED" == "True" ]]; then
    echo "-----> Domain $DOMAIN is already verified and ready to use"
    exit 0
  fi
else
  # Create identity
  aws sesv2 create-email-identity --email-identity "$DOMAIN" --region "$REGION" >/dev/null
  echo "       Identity created"
fi

# Get DKIM records
echo "-----> Getting DKIM records..."
DKIM_TOKENS=$(aws sesv2 get-email-identity --email-identity "$DOMAIN" --region "$REGION" \
  --query 'DkimAttributes.Tokens' --output text)

if [[ -z "$DKIM_TOKENS" ]] || [[ "$DKIM_TOKENS" == "None" ]]; then
  echo "!     Could not get DKIM tokens"
  exit 1
fi

# Find Route53 hosted zone
echo "-----> Finding Route53 hosted zone for $DOMAIN..."
HOSTED_ZONE_ID=$(aws route53 list-hosted-zones --query "HostedZones[?Name=='${DOMAIN}.'].Id" --output text | sed 's|/hostedzone/||')

if [[ -z "$HOSTED_ZONE_ID" ]]; then
  echo "!     No Route53 hosted zone found for $DOMAIN"
  echo ""
  echo "       Add these DKIM CNAME records manually:"
  for TOKEN in $DKIM_TOKENS; do
    echo "         ${TOKEN}._domainkey.${DOMAIN} -> ${TOKEN}.dkim.amazonses.com"
  done
  echo ""
  echo "       After adding records, verify with:"
  echo "         aws sesv2 get-email-identity --email-identity $DOMAIN --region $REGION"
  exit 0
fi

echo "       Found zone: $HOSTED_ZONE_ID"

# Add DKIM records
echo "-----> Adding DKIM records to Route53..."
CHANGES="["
FIRST=true
for TOKEN in $DKIM_TOKENS; do
  if [[ "$FIRST" != true ]]; then
    CHANGES="$CHANGES,"
  fi
  FIRST=false
  CHANGES="$CHANGES
    {
      \"Action\": \"UPSERT\",
      \"ResourceRecordSet\": {
        \"Name\": \"${TOKEN}._domainkey.${DOMAIN}\",
        \"Type\": \"CNAME\",
        \"TTL\": 300,
        \"ResourceRecords\": [{\"Value\": \"${TOKEN}.dkim.amazonses.com\"}]
      }
    }"
  echo "       Ensuring: ${TOKEN}._domainkey.${DOMAIN}"
done
CHANGES="$CHANGES]"

aws route53 change-resource-record-sets \
  --hosted-zone-id "$HOSTED_ZONE_ID" \
  --change-batch "{\"Changes\": $CHANGES}" >/dev/null

echo "-----> Domain $DOMAIN added to SES"
echo ""
echo "       DKIM verification may take a few minutes."
echo "       Check status: aws sesv2 get-email-identity --email-identity $DOMAIN --region $REGION"
echo ""
echo "       Once verified, you can send from any @$DOMAIN address."
