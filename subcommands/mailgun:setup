#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

PLUGIN_BASE_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$PLUGIN_BASE_PATH/config"

# Skip command name if passed
[[ "$1" == "mail:mailgun:setup" ]] && shift

SERVICE="${1:-default}"
DOMAIN="$2"
API_KEY="$3"

if [[ -z "$DOMAIN" ]]; then
  echo "Usage: dokku mail:mailgun:setup <service> <domain> [api-key]"
  echo ""
  echo "Set up Mailgun as the mail provider with optional DNS automation"
  echo ""
  echo "Arguments:"
  echo "  service    Mail service name (default: 'default')"
  echo "  domain     Your Mailgun sending domain"
  echo "  api-key    Mailgun API key (or will prompt)"
  echo ""
  echo "Options:"
  echo "  --region=<region>    Mailgun region: us (default) or eu"
  echo "  --skip-dns           Skip DNS record creation"
  echo ""
  echo "Requirements:"
  echo "  - Mailgun account (https://mailgun.com)"
  echo "  - API key from Mailgun dashboard"
  echo "  - dokku-dns plugin (optional, for DNS automation)"
  echo ""
  echo "Examples:"
  echo "  dokku mail:mailgun:setup default mg.example.com"
  echo "  dokku mail:mailgun:setup default mg.example.com key-abc123..."
  echo "  dokku mail:mailgun:setup default mg.example.com --region=eu"
  exit 1
fi

SERVICE_ROOT="$PLUGIN_DATA_ROOT/$SERVICE"

# Check if service exists
if [[ ! -d "$SERVICE_ROOT" ]]; then
  echo "!     Service $SERVICE does not exist"
  echo "      Run: dokku mail:create $SERVICE"
  exit 1
fi

# Parse options
REGION="us"
SKIP_DNS=""
for arg in "$@"; do
  case "$arg" in
    --region=*)
      REGION="${arg#*=}"
      ;;
    --skip-dns)
      SKIP_DNS="true"
      ;;
  esac
done

# Check if already configured
CURRENT_PROVIDER=$(cat "$SERVICE_ROOT/PROVIDER" 2>/dev/null || echo "")
if [[ "$CURRENT_PROVIDER" == "mailgun" ]]; then
  EXISTING_DOMAIN=$(cat "$SERVICE_ROOT/provider-config/DOMAIN" 2>/dev/null || echo "")
  if [[ -n "$EXISTING_DOMAIN" ]]; then
    echo "-----> Service $SERVICE is already configured for Mailgun"
    echo "       Domain: $EXISTING_DOMAIN"
    echo ""
    echo "       To reconfigure, first run: dokku mail:provider:reset $SERVICE"
    exit 0
  fi
fi

# Prompt for API key if not provided
if [[ -z "$API_KEY" ]]; then
  echo "Enter your Mailgun API key:"
  echo "(Find it at https://app.mailgun.com/app/account/security/api_keys)"
  read -rs API_KEY
  echo ""
fi

if [[ -z "$API_KEY" ]]; then
  echo "!     API key is required"
  exit 1
fi

echo "-----> Setting up Mailgun for $DOMAIN"

# Determine endpoint based on region
case "$REGION" in
  eu|EU|europe|EUROPE)
    REGION="eu"
    API_BASE="https://api.eu.mailgun.net/v3"
    SMTP_HOST="smtp.eu.mailgun.org"
    echo "       Region: EU"
    ;;
  *)
    REGION="us"
    API_BASE="https://api.mailgun.net/v3"
    SMTP_HOST="smtp.mailgun.org"
    echo "       Region: US"
    ;;
esac

# Verify API key and check/create domain
echo "-----> Verifying Mailgun credentials..."

DOMAIN_EXISTS=""
DOMAIN_BODY=""

if command -v curl &>/dev/null; then
  RESPONSE=$(curl -s -w "\n%{http_code}" \
    --user "api:$API_KEY" \
    "$API_BASE/domains/$DOMAIN" 2>/dev/null)

  HTTP_CODE=$(echo "$RESPONSE" | tail -n1)
  BODY=$(echo "$RESPONSE" | head -n -1)

  case "$HTTP_CODE" in
    200)
      echo "       ✓ API key valid"
      echo "       ✓ Domain $DOMAIN found"
      DOMAIN_EXISTS="true"
      DOMAIN_BODY="$BODY"

      # Check domain state if jq is available
      if command -v jq &>/dev/null; then
        STATE=$(echo "$BODY" | jq -r '.domain.state // "unknown"')
        if [[ "$STATE" == "active" ]]; then
          echo "       ✓ Domain is active"
        else
          echo "       ! Domain state: $STATE"
        fi
      fi
      ;;
    401)
      echo "!     Invalid API key"
      echo "       Check your API key at: https://app.mailgun.com/app/account/security/api_keys"
      exit 1
      ;;
    404)
      echo "       Domain $DOMAIN not found, will create it..."
      DOMAIN_EXISTS=""
      ;;
    *)
      echo "!     Failed to verify credentials (HTTP $HTTP_CODE)"
      echo "       Continuing anyway..."
      ;;
  esac
else
  echo "       Skipping API verification (curl not installed)"
fi

# Create domain in Mailgun if it doesn't exist
if [[ -z "$DOMAIN_EXISTS" ]] && command -v curl &>/dev/null; then
  echo "-----> Creating domain in Mailgun..."
  RESPONSE=$(curl -s -w "\n%{http_code}" \
    --user "api:$API_KEY" \
    -X POST "$API_BASE/domains" \
    -F name="$DOMAIN" 2>/dev/null)

  HTTP_CODE=$(echo "$RESPONSE" | tail -n1)
  BODY=$(echo "$RESPONSE" | head -n -1)

  case "$HTTP_CODE" in
    200|201)
      echo "       ✓ Domain created"
      DOMAIN_EXISTS="true"
      # Fetch full domain info including DNS records
      DOMAIN_BODY=$(curl -s --user "api:$API_KEY" "$API_BASE/domains/$DOMAIN" 2>/dev/null)
      ;;
    *)
      echo "!     Failed to create domain (HTTP $HTTP_CODE)"
      if command -v jq &>/dev/null; then
        MSG=$(echo "$BODY" | jq -r '.message // "Unknown error"')
        echo "       $MSG"
      fi
      echo "       Create domain manually at: https://app.mailgun.com/app/sending/domains"
      ;;
  esac
fi

# Set up DNS records via dokku-dns
if [[ -z "$SKIP_DNS" ]] && [[ -n "$DOMAIN_BODY" ]]; then
  # Check for dokku-dns
  if command -v dokku &>/dev/null && dokku dns:version &>/dev/null 2>&1; then
    echo "-----> Setting up DNS records via dokku-dns..."

    if command -v jq &>/dev/null; then
      # Extract sending DNS records from Mailgun response
      SENDING_RECORDS=$(echo "$DOMAIN_BODY" | jq -r '.sending_dns_records // empty')

      if [[ -n "$SENDING_RECORDS" ]] && [[ "$SENDING_RECORDS" != "null" ]]; then
        # Process each DNS record
        echo "$DOMAIN_BODY" | jq -c '.sending_dns_records[]' 2>/dev/null | while read -r record; do
          RECORD_TYPE=$(echo "$record" | jq -r '.record_type')
          RECORD_NAME=$(echo "$record" | jq -r '.name')
          RECORD_VALUE=$(echo "$record" | jq -r '.value')
          RECORD_VALID=$(echo "$record" | jq -r '.valid')

          if [[ "$RECORD_VALID" == "valid" ]]; then
            echo "       ✓ $RECORD_NAME ($RECORD_TYPE) - already valid"
          else
            echo "       Creating: $RECORD_NAME ($RECORD_TYPE)"
            if dokku dns:records:create "$RECORD_NAME" "$RECORD_TYPE" "$RECORD_VALUE" --ttl 300 >/dev/null 2>&1; then
              echo "         ✓ Added"
            else
              echo "         ✗ Failed (may already exist)"
            fi
          fi
        done

        # Add DMARC record
        DMARC_NAME="_dmarc.${DOMAIN}"
        DMARC_VALUE="v=DMARC1; p=none;"
        echo "-----> Adding DMARC record..."
        echo "       Creating: $DMARC_NAME"
        if dokku dns:records:create "$DMARC_NAME" TXT "$DMARC_VALUE" --ttl 300 >/dev/null 2>&1; then
          echo "         ✓ Added"
        else
          echo "         ✗ Failed (may already exist)"
        fi
      else
        echo "       Could not extract DNS records from Mailgun response"
      fi
    else
      echo "       jq not installed, skipping DNS automation"
      echo "       Install jq to enable automatic DNS record creation"
    fi
  else
    echo "-----> dokku-dns not available, skipping DNS automation"
    echo "       Install dokku-dns for automatic DNS record creation:"
    echo "         dokku plugin:install https://github.com/deanmarano/dokku-dns.git dns"
    echo ""
    echo "       Or manually add DNS records shown in Mailgun dashboard:"
    echo "         https://app.mailgun.com/app/sending/domains/$DOMAIN"
  fi
elif [[ -n "$SKIP_DNS" ]]; then
  echo "-----> Skipping DNS setup (--skip-dns flag)"
fi

# Test SMTP connectivity
echo "-----> Testing SMTP connectivity..."
if nc -z -w5 "$SMTP_HOST" 587 2>/dev/null; then
  echo "       ✓ SMTP endpoint reachable"
else
  echo "!     Cannot connect to $SMTP_HOST:587"
  echo "       Check your firewall settings"
  exit 1
fi

# Save configuration
echo "-----> Configuring mail service..."
mkdir -p "$SERVICE_ROOT/provider-config"
echo "mailgun" > "$SERVICE_ROOT/PROVIDER"
echo "$API_KEY" > "$SERVICE_ROOT/provider-config/API_KEY"
echo "$DOMAIN" > "$SERVICE_ROOT/provider-config/DOMAIN"
echo "$REGION" > "$SERVICE_ROOT/provider-config/REGION"

echo "-----> Applying provider configuration..."
dokku mail:provider:apply "$SERVICE"

echo ""
echo "-----> Mailgun setup complete!"
echo "       Domain: $DOMAIN"
echo "       Region: $REGION"
echo "       Service: $SERVICE"
echo ""

# Check final domain verification status
if [[ -n "$DOMAIN_BODY" ]] && command -v jq &>/dev/null; then
  STATE=$(echo "$DOMAIN_BODY" | jq -r '.domain.state // "unknown"')
  if [[ "$STATE" == "active" ]]; then
    echo "       Domain Status: Verified ✓"
  else
    echo "       Domain Status: $STATE (DNS verification pending)"
    echo ""
    echo "       DNS records may take a few minutes to propagate."
    echo "       Check status at: https://app.mailgun.com/app/sending/domains/$DOMAIN"
  fi
  echo ""
fi

echo "       Test with: dokku mail:test $SERVICE your@email.com"
