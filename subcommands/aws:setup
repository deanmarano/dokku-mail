#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

PLUGIN_BASE_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$PLUGIN_BASE_PATH/config"

# Function to generate SES SMTP password from IAM secret key
# Uses Python to handle binary data correctly (bash strips null bytes)
generate_ses_smtp_password() {
  local SECRET_KEY="$1"
  local REGION="$2"

  python3 << EOF
import hmac
import hashlib
import base64

secret_key = "$SECRET_KEY"
region = "$REGION"

# AWS SES SMTP password derivation algorithm
# https://docs.aws.amazon.com/ses/latest/dg/smtp-credentials.html
DATE = "11111111"
SERVICE = "ses"
TERMINAL = "aws4_request"
MESSAGE = "SendRawEmail"
VERSION = 0x04

def sign(key, msg):
    return hmac.new(key, msg.encode('utf-8'), hashlib.sha256).digest()

k_date = sign(("AWS4" + secret_key).encode('utf-8'), DATE)
k_region = sign(k_date, region)
k_service = sign(k_region, SERVICE)
k_terminal = sign(k_service, TERMINAL)
k_message = sign(k_terminal, MESSAGE)

signature = bytes([VERSION]) + k_message
print(base64.b64encode(signature).decode('utf-8'))
EOF
}

# Skip command name if passed
[[ "$1" == "mail:aws:setup" ]] && shift

SERVICE="${1:-default}"
DOMAIN="$2"
REGION="${3:-us-east-1}"

if [[ -z "$DOMAIN" ]]; then
  echo "Usage: dokku mail:aws:setup <service> <domain> [region]"
  echo ""
  echo "Automatically set up AWS SES for a domain:"
  echo "  - Creates SES identity"
  echo "  - Adds DKIM and DMARC records via dokku-dns"
  echo "  - Creates SMTP credentials"
  echo "  - Configures the mail service"
  echo ""
  echo "Requirements:"
  echo "  - AWS CLI configured with appropriate permissions"
  echo "  - dokku-dns plugin installed and configured"
  echo ""
  echo "Example:"
  echo "  dokku mail:aws:setup default example.com us-east-1"
  exit 1
fi

SERVICE_ROOT="$PLUGIN_DATA_ROOT/$SERVICE"

# Check if service exists
if [[ ! -d "$SERVICE_ROOT" ]]; then
  echo "!     Service $SERVICE does not exist"
  echo "      Run: dokku mail:create $SERVICE"
  exit 1
fi

# Check if already configured with AWS
CURRENT_PROVIDER=$(cat "$SERVICE_ROOT/PROVIDER" 2>/dev/null || echo "")
if [[ "$CURRENT_PROVIDER" == "aws" ]]; then
  EXISTING_USERNAME=$(cat "$SERVICE_ROOT/provider-config/SMTP_USERNAME" 2>/dev/null || echo "")
  EXISTING_REGION=$(cat "$SERVICE_ROOT/provider-config/AWS_REGION" 2>/dev/null || echo "")
  if [[ -n "$EXISTING_USERNAME" ]] && [[ "$EXISTING_REGION" == "$REGION" ]]; then
    echo "-----> Service $SERVICE is already configured for AWS SES in $REGION"
    echo "       SMTP Username: ${EXISTING_USERNAME:0:4}***${EXISTING_USERNAME: -4}"
    echo ""
    echo "       To reconfigure, first run: dokku mail:provider:reset $SERVICE"
    echo "       Then run this command again."
    exit 0
  fi
fi

# Check for dokku-dns
if ! command -v dokku &>/dev/null || ! dokku dns:version &>/dev/null 2>&1; then
  echo "!     dokku-dns plugin is required but not installed"
  echo ""
  echo "      Install it with:"
  echo "        dokku plugin:install https://github.com/deanmarano/dokku-dns.git dns"
  echo ""
  echo "      Then configure a DNS provider for your domain."
  exit 1
fi

# Check for AWS CLI
if ! command -v aws &>/dev/null; then
  echo "!     AWS CLI not found. Please install it first."
  exit 1
fi

# Check AWS credentials
echo "-----> Checking AWS credentials..."
if ! aws sts get-caller-identity &>/dev/null; then
  echo "!     AWS credentials not configured or invalid"
  echo "      Run: aws configure"
  exit 1
fi

AWS_ACCOUNT_ID=$(aws sts get-caller-identity --query 'Account' --output text)
echo "       Account: $AWS_ACCOUNT_ID"

# Step 1: Create SES identity
echo "-----> Creating SES identity for $DOMAIN..."
if aws sesv2 get-email-identity --email-identity "$DOMAIN" --region "$REGION" &>/dev/null; then
  echo "       Identity already exists, fetching DKIM records..."
else
  aws sesv2 create-email-identity --email-identity "$DOMAIN" --region "$REGION" >/dev/null
  echo "       Identity created"
fi

# Step 2: Get DKIM records and status
echo "-----> Checking DKIM status..."
DKIM_STATUS=$(aws sesv2 get-email-identity --email-identity "$DOMAIN" --region "$REGION" \
  --query 'DkimAttributes.DkimSigningEnabled' --output text)
DKIM_VERIFICATION=$(aws sesv2 get-email-identity --email-identity "$DOMAIN" --region "$REGION" \
  --query 'DkimAttributes.Status' --output text)
DKIM_TOKENS=$(aws sesv2 get-email-identity --email-identity "$DOMAIN" --region "$REGION" \
  --query 'DkimAttributes.Tokens' --output text)

echo "       DKIM Status: $DKIM_VERIFICATION"

if [[ -z "$DKIM_TOKENS" ]] || [[ "$DKIM_TOKENS" == "None" ]]; then
  echo "!     Could not get DKIM tokens"
  exit 1
fi

# Step 3: Add DKIM records via dokku-dns
echo "-----> Adding DKIM records via dokku-dns..."
for TOKEN in $DKIM_TOKENS; do
  RECORD_NAME="${TOKEN}._domainkey.${DOMAIN}"
  RECORD_VALUE="${TOKEN}.dkim.amazonses.com"
  echo "       Creating: $RECORD_NAME"
  if dokku dns:records:create "$RECORD_NAME" CNAME "$RECORD_VALUE" --ttl 300 >/dev/null 2>&1; then
    echo "         ✓ Added"
  else
    echo "         ✗ Failed (may already exist)"
  fi
done

# Step 4: Add DMARC record
DMARC_NAME="_dmarc.${DOMAIN}"
DMARC_VALUE="v=DMARC1; p=none;"
echo "-----> Adding DMARC record..."
echo "       Creating: $DMARC_NAME"
if dokku dns:records:create "$DMARC_NAME" TXT "$DMARC_VALUE" --ttl 300 >/dev/null 2>&1; then
  echo "         ✓ Added"
else
  echo "         ✗ Failed (may already exist)"
fi

# Step 5: Create SMTP credentials
echo "-----> Creating SMTP credentials..."
IAM_USER="ses-smtp-user-dokku-mail-${SERVICE}"

# Check if user already exists
if aws iam get-user --user-name "$IAM_USER" &>/dev/null; then
  echo "       IAM user $IAM_USER already exists"

  # Check if user has access keys
  EXISTING_KEYS=$(aws iam list-access-keys --user-name "$IAM_USER" --query 'AccessKeyMetadata[*].AccessKeyId' --output text)
  if [[ -n "$EXISTING_KEYS" ]]; then
    echo "       User has existing access keys, deleting old keys..."
    for KEY_ID in $EXISTING_KEYS; do
      aws iam delete-access-key --user-name "$IAM_USER" --access-key-id "$KEY_ID"
      echo "       Deleted key: $KEY_ID"
    done
  fi
else
  # Create IAM user
  aws iam create-user --user-name "$IAM_USER" >/dev/null
  echo "       Created IAM user: $IAM_USER"
fi

# Ensure policy is attached (idempotent)
aws iam put-user-policy --user-name "$IAM_USER" --policy-name "SESSendPolicy" --policy-document '{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "ses:SendRawEmail",
      "Resource": "*"
    }
  ]
}'

# Create new access key
echo "       Creating new access key..."
CREDENTIALS=$(aws iam create-access-key --user-name "$IAM_USER" --query 'AccessKey.[AccessKeyId,SecretAccessKey]' --output text)
ACCESS_KEY_ID=$(echo "$CREDENTIALS" | cut -f1)
SECRET_ACCESS_KEY=$(echo "$CREDENTIALS" | cut -f2)

# Generate SMTP password from secret key
echo "-----> Generating SMTP password..."
SMTP_PASSWORD=$(generate_ses_smtp_password "$SECRET_ACCESS_KEY" "$REGION")

# Step 6: Configure the mail service
echo "-----> Configuring mail service..."
mkdir -p "$SERVICE_ROOT/provider-config"
echo "aws" > "$SERVICE_ROOT/PROVIDER"
echo "$ACCESS_KEY_ID" > "$SERVICE_ROOT/provider-config/SMTP_USERNAME"
echo "$SMTP_PASSWORD" > "$SERVICE_ROOT/provider-config/SMTP_PASSWORD"
echo "$REGION" > "$SERVICE_ROOT/provider-config/AWS_REGION"
echo "$DOMAIN" > "$SERVICE_ROOT/provider-config/SENDER_DOMAIN"

echo "-----> Applying provider configuration..."
dokku mail:provider:apply "$SERVICE"

echo ""
echo "-----> AWS SES setup complete!"
echo "       Domain: $DOMAIN"
echo "       Region: $REGION"
echo "       Service: $SERVICE"
echo ""

# Check DKIM status
DKIM_FINAL_STATUS=$(aws sesv2 get-email-identity --email-identity "$DOMAIN" --region "$REGION" \
  --query 'DkimAttributes.Status' --output text 2>/dev/null || echo "UNKNOWN")
if [[ "$DKIM_FINAL_STATUS" == "SUCCESS" ]]; then
  echo "       DKIM: Verified ✓"
else
  echo "       DKIM: $DKIM_FINAL_STATUS (may take a few minutes to verify)"
fi
echo ""

# Check sandbox status
SANDBOX_MODE=true
if PRODUCTION_ACCESS=$(aws sesv2 get-account --query 'ProductionAccessEnabled' --output text 2>/dev/null); then
  if [[ "$PRODUCTION_ACCESS" == "True" ]]; then
    SANDBOX_MODE=false
  fi
fi

if [[ "$SANDBOX_MODE" == "true" ]]; then
  echo "=====> IMPORTANT: SES Sandbox Mode"
  echo ""
  echo "       Your SES account is in SANDBOX MODE. You can only send to"
  echo "       verified email addresses until you request production access."
  echo ""
  echo "       To test email delivery, verify a recipient email:"
  echo ""
  echo "         aws sesv2 create-email-identity --email-identity your@email.com --region $REGION"
  echo ""
  echo "       Then check that inbox and click the verification link."
  echo ""
  echo "       For production use, request access in the AWS Console:"
  echo "         SES → Account dashboard → Request production access"
  echo ""
else
  echo "       SES: Production access enabled ✓"
fi
