#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

PLUGIN_BASE_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$PLUGIN_BASE_PATH/config"
source "$PLUGIN_BASE_PATH/providers/loader.sh"

# Skip command name if passed
[[ "$1" == "mail:doctor" ]] && shift

SERVICE=""
VERBOSE=false

# Parse arguments
for arg in "$@"; do
  case "$arg" in
    -v|--verbose)
      VERBOSE=true
      ;;
    -*)
      echo "Unknown option: $arg"
      exit 1
      ;;
    *)
      if [[ -z "$SERVICE" ]]; then
        SERVICE="$arg"
      fi
      ;;
  esac
done

SERVICE="${SERVICE:-default}"

SERVICE_ROOT="$PLUGIN_DATA_ROOT/$SERVICE"
CONTAINER_NAME="dokku.mail.$SERVICE"

ERRORS=0
WARNINGS=0

check_pass() {
  echo "       ✓ $1"
}

check_fail() {
  echo "       ✗ $1"
  ((ERRORS++)) || true
}

check_warn() {
  echo "       ! $1"
  ((WARNINGS++)) || true
}

verbose() {
  if [[ "$VERBOSE" == true ]]; then
    echo "       [verbose] $1"
  fi
}

echo "=====> Running diagnostics for mail service: $SERVICE"
echo ""

# 1. Service exists
echo "-----> Checking service..."
if [[ -d "$SERVICE_ROOT" ]]; then
  check_pass "Service directory exists"
else
  check_fail "Service directory not found"
  echo ""
  echo "       Run: dokku mail:create $SERVICE"
  exit 1
fi

# 2. Container running
echo "-----> Checking container..."
if docker ps -q -f "name=^${CONTAINER_NAME}$" | grep -q .; then
  check_pass "Container is running"

  CONTAINER_IP=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "$CONTAINER_NAME")
  check_pass "Container IP: $CONTAINER_IP"

  if [[ "$VERBOSE" == true ]]; then
    CONTAINER_IMAGE=$(docker inspect -f '{{.Config.Image}}' "$CONTAINER_NAME" 2>/dev/null || echo "unknown")
    CONTAINER_CREATED=$(docker inspect -f '{{.Created}}' "$CONTAINER_NAME" 2>/dev/null | cut -d'T' -f1 || echo "unknown")
    CONTAINER_RESTART=$(docker inspect -f '{{.HostConfig.RestartPolicy.Name}}' "$CONTAINER_NAME" 2>/dev/null || echo "unknown")
    verbose "Image: $CONTAINER_IMAGE"
    verbose "Created: $CONTAINER_CREATED"
    verbose "Restart policy: $CONTAINER_RESTART"
  fi
else
  check_fail "Container is not running"
  verbose "Try: dokku mail:provider:apply $SERVICE"
fi

# 3. Provider configuration
echo "-----> Checking provider..."
PROVIDER=$(cat "$SERVICE_ROOT/PROVIDER" 2>/dev/null || echo "")
if [[ -n "$PROVIDER" ]]; then
  check_pass "Provider: $PROVIDER"
  verbose "Provider path: $PLUGIN_BASE_PATH/providers/$PROVIDER/provider.sh"
else
  check_fail "No provider configured"
fi

load_provider "$SERVICE"

if [[ "$VERBOSE" == true ]] && [[ -d "$SERVICE_ROOT/provider-config" ]]; then
  verbose "Config directory: $SERVICE_ROOT/provider-config"
  for config_file in "$SERVICE_ROOT/provider-config"/*; do
    if [[ -f "$config_file" ]]; then
      key=$(basename "$config_file")
      # Mask sensitive values
      if [[ "$key" == *PASSWORD* ]] || [[ "$key" == *KEY* ]] || [[ "$key" == *SECRET* ]]; then
        verbose "  $key: ****"
      else
        value=$(cat "$config_file" 2>/dev/null || echo "")
        verbose "  $key: $value"
      fi
    fi
  done
fi

# 4. Provider-specific checks
if type provider_doctor &>/dev/null; then
  provider_issues=0
  provider_doctor "$SERVICE" || provider_issues=$?
  if [[ $provider_issues -gt 0 ]]; then
    ERRORS=$((ERRORS + provider_issues))
  fi
else
  check_warn "Provider $PROVIDER does not have diagnostics"
fi

# 5. Check linked apps
echo "-----> Checking linked apps..."
if [[ -f "$SERVICE_ROOT/LINKS" ]] && [[ -s "$SERVICE_ROOT/LINKS" ]]; then
  CONTAINER_IP=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "$CONTAINER_NAME" 2>/dev/null || echo "")
  CONTAINER_HOSTNAME="$CONTAINER_NAME"
  SMTP_PORT=$(provider_get_smtp_port)

  while IFS= read -r APP; do
    [[ -z "$APP" ]] && continue

    if dokku apps:exists "$APP" &>/dev/null; then
      # Check if app has correct SMTP_HOST (accept either IP or hostname)
      APP_SMTP_HOST=$(dokku config:get "$APP" SMTP_HOST 2>/dev/null || echo "")
      APP_SMTP_PORT=$(dokku config:get "$APP" SMTP_PORT 2>/dev/null || echo "")

      if [[ "$APP_SMTP_PORT" == "$SMTP_PORT" ]] && { [[ "$APP_SMTP_HOST" == "$CONTAINER_IP" ]] || [[ "$APP_SMTP_HOST" == "$CONTAINER_HOSTNAME" ]]; }; then
        check_pass "App $APP: correctly configured"
      else
        check_warn "App $APP: config drift detected"
        echo "         Expected: SMTP_HOST=$CONTAINER_HOSTNAME SMTP_PORT=$SMTP_PORT"
        echo "         Actual:   SMTP_HOST=$APP_SMTP_HOST SMTP_PORT=$APP_SMTP_PORT"
        echo "         Run: dokku mail:link $SERVICE $APP"
      fi
    else
      check_warn "App $APP: linked but app doesn't exist"
    fi
  done < "$SERVICE_ROOT/LINKS"
else
  check_pass "No linked apps"
fi

# Summary
echo ""
echo "=====> Diagnostics complete"
if [[ $ERRORS -gt 0 ]]; then
  echo "       $ERRORS error(s), $WARNINGS warning(s)"
  exit 1
elif [[ $WARNINGS -gt 0 ]]; then
  echo "       $WARNINGS warning(s)"
  exit 0
else
  echo "       All checks passed!"
  exit 0
fi
