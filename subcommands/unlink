#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

PLUGIN_BASE_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$PLUGIN_BASE_PATH/config"

# Skip command name if passed
[[ "$1" == "mail:unlink" ]] && shift

SERVICE="$1"
APP="$2"

if [[ -z "$SERVICE" ]] || [[ -z "$APP" ]]; then
  echo "Usage: dokku mail:unlink <name> <app>"
  echo ""
  echo "Unlink an app from a mail service"
  exit 1
fi

SERVICE_ROOT="$PLUGIN_DATA_ROOT/$SERVICE"
NETWORK_NAME="dokku.mail.$SERVICE"
LINKED_VARS_DIR="$SERVICE_ROOT/linked-vars"

# Check if service exists
if [[ ! -d "$SERVICE_ROOT" ]]; then
  echo "!     Service $SERVICE does not exist"
  exit 1
fi

# Check if linked
if ! grep -q "^$APP$" "$SERVICE_ROOT/LINKS" 2>/dev/null; then
  echo "!     App $APP is not linked to $SERVICE"
  exit 1
fi

echo "-----> Unlinking $APP from mail service $SERVICE"

# Build list of variables to unset from stored linked-vars
UNSET_VARS=()
LINKED_VARS_FILE="$LINKED_VARS_DIR/$APP"

if [[ -f "$LINKED_VARS_FILE" ]]; then
  # Use the stored list of vars that were set during link
  while IFS= read -r var || [[ -n "$var" ]]; do
    [[ -z "$var" ]] && continue
    UNSET_VARS+=("$var")
  done < "$LINKED_VARS_FILE"
else
  # Fallback for links created before this feature: use defaults
  UNSET_VARS=(SMTP_HOST SMTP_PORT MAIL_URL)
fi

# Remove environment variables from the app
if [[ ${#UNSET_VARS[@]} -gt 0 ]]; then
  echo "-----> Removing config vars"
  for var in "${UNSET_VARS[@]}"; do
    echo "       $var"
  done
  dokku config:unset --no-restart "$APP" "${UNSET_VARS[@]}" 2>/dev/null || true
fi

# Detach app from mail service network
echo "-----> Detaching $APP from network $NETWORK_NAME"
dokku network:set "$APP" attach-post-deploy "" 2>/dev/null || true

# Remove from links file
grep -v "^$APP$" "$SERVICE_ROOT/LINKS" > "$SERVICE_ROOT/LINKS.tmp" || true
mv "$SERVICE_ROOT/LINKS.tmp" "$SERVICE_ROOT/LINKS"

# Remove the stored linked-vars file
rm -f "$LINKED_VARS_FILE"

echo "-----> $APP unlinked from $SERVICE"
echo ""
echo "       Restart your app to apply: dokku ps:restart $APP"
