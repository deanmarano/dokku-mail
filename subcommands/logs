#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

PLUGIN_BASE_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$PLUGIN_BASE_PATH/config"

SERVICE="$1"
shift || true

if [[ -z "$SERVICE" ]]; then
  echo "Usage: dokku mail:logs <name> [-t|--tail]"
  echo ""
  echo "Show logs for a mail service"
  exit 1
fi

SERVICE_ROOT="$PLUGIN_DATA_ROOT/$SERVICE"
CONTAINER_NAME="dokku.mail.$SERVICE"

# Check if service exists
if [[ ! -d "$SERVICE_ROOT" ]]; then
  echo "!     Service $SERVICE does not exist"
  exit 1
fi

# Pass remaining args to docker logs (e.g., -f, --tail)
docker logs "$CONTAINER_NAME" "$@"
