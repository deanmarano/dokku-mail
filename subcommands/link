#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

PLUGIN_BASE_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$PLUGIN_BASE_PATH/config"
source "$PLUGIN_BASE_PATH/providers/loader.sh"

# Skip command name if passed
[[ "$1" == "mail:link" ]] && shift

SERVICE="$1"
APP="$2"

if [[ -z "$SERVICE" ]] || [[ -z "$APP" ]]; then
  echo "Usage: dokku mail:link <name> <app>"
  echo ""
  echo "Link an app to a mail service"
  echo ""
  echo "Custom vars can be configured with:"
  echo "  dokku mail:vars:set <app> KEY=VALUE"
  echo "  dokku mail:vars:set <app> --template=lldap"
  exit 1
fi

SERVICE_ROOT="$PLUGIN_DATA_ROOT/$SERVICE"
CONTAINER_NAME="dokku.mail.$SERVICE"
VARS_DIR="$PLUGIN_DATA_ROOT/app-vars"

# Check if service exists
if [[ ! -d "$SERVICE_ROOT" ]]; then
  echo "!     Service $SERVICE does not exist"
  echo "      Run: dokku mail:create $SERVICE"
  exit 1
fi

# Check if app exists
if ! dokku apps:exists "$APP" 2>/dev/null; then
  echo "!     App $APP does not exist"
  exit 1
fi

# Check if already linked to THIS service
if grep -q "^$APP$" "$SERVICE_ROOT/LINKS" 2>/dev/null; then
  echo "!     App $APP is already linked to $SERVICE"
  exit 1
fi

# Check if linked to ANY other mail service and unlink first
for other_service_dir in "$PLUGIN_DATA_ROOT"/*/; do
  other_service=$(basename "$other_service_dir")
  [[ "$other_service" == "$SERVICE" ]] && continue
  [[ "$other_service" == "app-vars" ]] && continue
  if grep -q "^$APP$" "$other_service_dir/LINKS" 2>/dev/null; then
    echo "-----> Unlinking $APP from existing mail service $other_service"
    # Remove from other service's links
    grep -v "^$APP$" "$other_service_dir/LINKS" > "$other_service_dir/LINKS.tmp" || true
    mv "$other_service_dir/LINKS.tmp" "$other_service_dir/LINKS"
  fi
done

# Load provider to get SMTP port
load_provider "$SERVICE"
SMTP_PORT=$(provider_get_smtp_port)

# Get container IP for the app to connect to
CONTAINER_IP=$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' "$CONTAINER_NAME")

if [[ -z "$CONTAINER_IP" ]]; then
  echo "!     Could not get container IP. Is the service running?"
  exit 1
fi

# Get sender domain from provider config if available
SENDER_DOMAIN=""
if [[ -f "$SERVICE_ROOT/provider-config/SENDER_DOMAIN" ]]; then
  SENDER_DOMAIN=$(cat "$SERVICE_ROOT/provider-config/SENDER_DOMAIN")
fi

echo "-----> Linking $APP to mail service $SERVICE"

# Function to expand placeholders in a value
expand_placeholders() {
  local value="$1"
  value="${value//\{\{HOST\}\}/$CONTAINER_IP}"
  value="${value//\{\{PORT\}\}/$SMTP_PORT}"
  value="${value//\{\{DOMAIN\}\}/$SENDER_DOMAIN}"
  value="${value//\{\{APP\}\}/$APP}"
  echo "$value"
}

# Start with default vars
declare -a CONFIG_VARS
CONFIG_VARS=(
  "SMTP_HOST=$CONTAINER_IP"
  "SMTP_PORT=$SMTP_PORT"
  "MAIL_URL=smtp://$CONTAINER_IP:$SMTP_PORT"
)

echo "-----> Setting default vars"
echo "       SMTP_HOST=$CONTAINER_IP"
echo "       SMTP_PORT=$SMTP_PORT"
echo "       MAIL_URL=smtp://$CONTAINER_IP:$SMTP_PORT"

# Add custom vars if configured for this app
APP_VARS_FILE="$VARS_DIR/$APP"
if [[ -f "$APP_VARS_FILE" ]]; then
  echo "-----> Setting custom vars"
  while IFS= read -r line || [[ -n "$line" ]]; do
    # Skip empty lines and comments
    [[ -z "$line" ]] && continue
    [[ "$line" =~ ^# ]] && continue

    KEY="${line%%=*}"
    VALUE="${line#*=}"

    # Expand placeholders
    EXPANDED_VALUE=$(expand_placeholders "$VALUE")

    CONFIG_VARS+=("${KEY}=${EXPANDED_VALUE}")
    echo "       ${KEY}=${EXPANDED_VALUE}"
  done < "$APP_VARS_FILE"
fi

# Set environment variables on the app
dokku config:set --no-restart "$APP" "${CONFIG_VARS[@]}" >/dev/null

# Record the link
echo "$APP" >> "$SERVICE_ROOT/LINKS"

echo "-----> $APP linked to $SERVICE"
echo ""
echo "       Restart your app to apply: dokku ps:restart $APP"
