#!/usr/bin/env bash
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

PLUGIN_BASE_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$PLUGIN_BASE_PATH/config"
source "$PLUGIN_BASE_PATH/providers/loader.sh"

# Skip command name if passed
[[ "$1" == "mail:provider:apply" ]] && shift

SERVICE="${1:-default}"

SERVICE_ROOT="$PLUGIN_DATA_ROOT/$SERVICE"
CONTAINER_NAME="dokku.mail.$SERVICE"
NETWORK_NAME="dokku.mail.$SERVICE"

# Check if service exists
if [[ ! -d "$SERVICE_ROOT" ]]; then
  echo "!     Service $SERVICE does not exist"
  exit 1
fi

# Load provider
load_provider "$SERVICE"

echo "-----> Applying provider $PROVIDER_NAME to service $SERVICE"

# Validate configuration before proceeding
echo "-----> Validating configuration..."
if type provider_validate_config &>/dev/null; then
  if ! provider_validate_config "$SERVICE"; then
    echo "!     Configuration validation failed"
    exit 1
  fi
  echo "       Configuration valid"
else
  # Fallback: check required config keys exist
  if [[ -n "$PROVIDER_REQUIRED_CONFIG" ]]; then
    CONFIG_DIR="$SERVICE_ROOT/provider-config"
    for key in $PROVIDER_REQUIRED_CONFIG; do
      if [[ ! -f "$CONFIG_DIR/$key" ]] || [[ -z "$(cat "$CONFIG_DIR/$key" 2>/dev/null)" ]]; then
        echo "!     Missing required config: $key"
        exit 1
      fi
    done
    echo "       Configuration valid"
  fi
fi

# Stop and remove existing container
if docker ps -aq -f "name=$CONTAINER_NAME" | grep -q .; then
  echo "-----> Stopping existing container"
  docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
fi

# Ensure network exists
docker network create "$NETWORK_NAME" 2>/dev/null || true

# Pull new image
echo "-----> Pulling $PROVIDER_IMAGE:$PROVIDER_IMAGE_VERSION"
docker pull "$PROVIDER_IMAGE:$PROVIDER_IMAGE_VERSION" || true

# Create new container (pass network name via env)
echo "-----> Starting container with $PROVIDER_NAME provider"
export MAIL_NETWORK="$NETWORK_NAME"
if ! provider_create_container "$SERVICE"; then
  echo "!     Failed to create container"
  exit 1
fi

# Update stored image info
echo "$PROVIDER_IMAGE:$PROVIDER_IMAGE_VERSION" > "$SERVICE_ROOT/IMAGE"

# Wait for container to start
sleep 2
SMTP_PORT=$(provider_get_smtp_port "$SERVICE")

echo "-----> Provider $PROVIDER_NAME applied to $SERVICE"
echo "       Container: $CONTAINER_NAME"
echo "       Network: $NETWORK_NAME"
echo "       SMTP Port: $SMTP_PORT"

# Check for linked apps
if [[ -f "$SERVICE_ROOT/LINKS" ]] && [[ -s "$SERVICE_ROOT/LINKS" ]]; then
  LINKED_COUNT=$(grep -c . "$SERVICE_ROOT/LINKS" 2>/dev/null || echo "0")
  echo ""
  echo "       $LINKED_COUNT linked app(s) - no config update needed"
  echo "       (Apps use container name for SMTP_HOST, which is stable)"
  echo ""
  echo "       Restart your apps to apply changes: dokku ps:restart <app>"
fi
